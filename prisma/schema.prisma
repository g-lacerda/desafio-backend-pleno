generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String
  preferredLanguage Language @default(EN)
  apiKeyHash        String   @unique
  passwordHash      String
  orders            Order[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([apiKeyHash])
  @@map("users")
}

enum Language {
  PT_BR @map("pt-BR")
  EN    @map("en")
  ES    @map("es")
}

model Order {
  id                   String      @id @default(uuid())
  externalOrderId      String      @unique
  customerEmail        String
  customerName         String
  items                Json
  currency             String
  totalOriginalCents   Int
  totalConvertedCents  Int?
  conversionRateMicros Int?
  status               OrderStatus @default(RECEIVED)
  failureReason        String?
  // Multi-tenancy opcional: se o webhook informou `user_id`, o pedido é "dono"
  // daquele user e só ele vê via GET /orders. Se NULL, é global e qualquer user
  // autenticado vê. O modelo casa com webhooks vindos de sistemas externos —
  // alguns rotulam o tenant (marketplace), outros despejam pedidos públicos.
  userId               String?
  user                 User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@map("orders")
}

enum OrderStatus {
  RECEIVED
  ENRICHING
  ENRICHED
  FAILED_ENRICHMENT
}

model IdempotencyKey {
  key            String            @id
  requestHash    String
  status         IdempotencyStatus
  responseStatus Int?
  // Texto cru (JSON serializado preservando ordem das chaves) em vez de Json/jsonb,
  // que reordena chaves por design no Postgres e quebra o contrato de "replay
  // byte-a-byte". Persistimos exatamente os bytes que o cliente recebeu.
  responseBody   String?
  orderId        String?
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}
