# Application
NODE_ENV=development
PORT=3000
UI_PORT=8080

# PostgreSQL (também usado pelo docker-compose)
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator?schema=public

# Redis (também usado pelo docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# i18n
DEFAULT_LANGUAGE=en

# Throttler — proteção contra flood no POST /webhooks/orders
WEBHOOK_THROTTLE_TTL_SECONDS=10
WEBHOOK_THROTTLE_LIMIT=20

# Idempotência — janela durante a qual a mesma idempotency_key é considerada duplicada
IDEMPOTENCY_TTL_HOURS=24

# AwesomeAPI — usada para enriquecimento de pedidos com taxa de câmbio
AWESOMEAPI_BASE_URL=https://economia.awesomeapi.com.br
AWESOMEAPI_TIMEOUT_MS=5000
# Opcional: token reduz rate limit. Deixe vazio para usar o tier público.
AWESOMEAPI_TOKEN=

# Enrichment worker — quantas vezes tentar antes de mover pra DLQ
ENRICHMENT_MAX_ATTEMPTS=3
ENRICHMENT_BACKOFF_BASE_MS=1000

# Admin API key — protege POST /users e Bull Board (/admin/queues).
# Em produção, gere com: `openssl rand -base64 32`. Mínimo 16 caracteres.
ADMIN_API_KEY=change-me-to-a-strong-random-secret
